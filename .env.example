# ---------------------------------------------------------------------------
# tech-x-agent — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true
API_HOST=127.0.0.1
API_PORT=8000
# Required for /drafts and /metrics. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# --- database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://techx:techx@localhost:55432/techx

# --- LLM (Google Gemini API via Google AI Studio) ----------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=1000
LLM_TEMPERATURE=0.8
LLM_REASONING_EFFORT=low

# --- Google Gemini 2.5 Flash Rate Limits ------------------------------
# Official Google AI Studio limits:
# Free Tier: 15 RPM | 1,000,000 TPM | 1,500 RPD
# Paid Tier 1: 1,000 RPM | 4,000,000 TPM
LLM_RATE_LIMIT_ENABLED=true
LLM_REQUESTS_PER_MINUTE=15
LLM_TOKENS_PER_MINUTE=1000000
LLM_REQUESTS_PER_DAY=1500
LLM_TOKENS_PER_DAY=10000000
LLM_RATE_LIMIT_SAFETY_RATIO=0.9
LLM_CHARS_PER_TOKEN=3.5
# Optional cost estimation (USD per million tokens) and hard budgets.
# Gemini's free tier has no per-token charge; set prices if you are on a paid plan.
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0
LLM_DAILY_BUDGET_USD=0        # 0 = unlimited
LLM_MONTHLY_BUDGET_USD=0      # 0 = unlimited
LLM_MAX_REQUESTS_PER_DAY=200

# --- embeddings (local) ----------------------------------------------------
EMBEDDING_PROVIDER=sentence_transformers   # sentence_transformers | hashing (dev/test only)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384      # must match the model and the migrated vector column
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- X (official API only) -------------------------------------------------
X_API_BASE_URL=https://api.x.com/2
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
X_READS_ENABLED=false         # requires API access that includes the read endpoints
X_RESEARCH_ENABLED=false      # optional mention ingestion (never trends / scraping)
X_PERSONA_HANDLE=             # e.g. techbrief (used to resolve the account)

# --- controls / kill switches ---------------------------------------------
DISCOVERY_ENABLED=true
DRAFTING_ENABLED=true
PUBLISHING_ENABLED=false      # master switch: no outbound posting unless true
EMERGENCY_PAUSE=false
DRY_RUN=true                  # simulate publishing; never calls X
MAX_ORIGINAL_POSTS_PER_DAY=6
MAX_REPLIES_PER_DAY=5
MIN_HOURS_BETWEEN_POSTS=1.5
PUBLISH_MIN_SCORE=0.5
MAX_POST_LENGTH=280
MAX_THREAD_PARTS=4
# Tokens/minute is the binding constraint on the free tier, so source excerpts
# are kept short. Raise this only if your TPM limit is higher.
DRAFT_SOURCE_CONTEXT_CHARS=2600

# --- persona / content mix -------------------------------------------------
# Which shapes the account posts, and how often. The application picks the
# format from these weights; the model is told what to write and cannot choose.
# Formats: shitpost | hot_take | relatable | news_jab | explainer
POST_FORMAT_MIX=shitpost:0.35,hot_take:0.25,relatable:0.20,news_jab:0.15,explainer:0.05

# Replies stay draft-only unless BOTH flags below are true AND X has granted
# prior written approval for automated replies. Enabling one without the other
# makes the application refuse to start.
AI_REPLY_APPROVAL_OBTAINED=false
AI_REPLY_PUBLISHING_ENABLED=false

# --- research sources ------------------------------------------------------
# Comma or newline separated allowlists. Only http(s) public URLs are fetched.
RSS_FEEDS=
GITHUB_REPOSITORIES=
GITHUB_SEARCH_QUERIES=
GITHUB_TOKEN=
GITHUB_INCLUDE_PRERELEASES=false
FRESHNESS_WINDOW_HOURS=48
FRESHNESS_HALF_LIFE_HOURS=24
MAX_CANDIDATES_PER_RUN=15
MIN_CANDIDATE_SCORE=0.3
MAX_ARTICLE_FETCHES_PER_RUN=10
PER_HOST_MIN_INTERVAL_SECONDS=5
HTTP_TIMEOUT_SECONDS=20
HTTP_USER_AGENT=tech-x-agent/0.1 (research bot; contact: you@example.com)

# --- scoring weights (normalised internally) ------------------------------
WEIGHT_FRESHNESS=0.22
WEIGHT_TECHNICAL_RELEVANCE=0.23
WEIGHT_NOVELTY=0.20
WEIGHT_SOURCE_RELIABILITY=0.15
WEIGHT_EVIDENCE_QUALITY=0.12
WEIGHT_AUDIENCE_USEFULNESS=0.08

# --- retrieval -------------------------------------------------------------
RETRIEVAL_RRF_K=60
RETRIEVAL_MAX_RESULTS=8
RETRIEVAL_MIN_SIMILARITY=0.05
DUPLICATE_SIMILARITY_THRESHOLD=0.92
DUPLICATE_JACCARD_THRESHOLD=0.80

# --- scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=false
INGEST_INTERVAL_MINUTES=60
RANK_INTERVAL_MINUTES=120
DRAFT_INTERVAL_MINUTES=180
PUBLISH_INTERVAL_MINUTES=30
REPLY_DRAFT_INTERVAL_MINUTES=60
CONSOLIDATION_INTERVAL_HOURS=24
ANALYTICS_INTERVAL_HOURS=6

# --- analytics -------------------------------------------------------------
ANALYTICS_ENABLED=false
